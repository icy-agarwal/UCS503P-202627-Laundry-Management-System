# Real database (Supabase): project URL + PUBLISHABLE key only (Supabase -> Project Settings -> API Keys).
# Leave both empty to run in DEMO mode (in-memory data, OTP is always 123456).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Optional: your own Express server instead of Supabase.
EXPO_PUBLIC_API_URL=
# Optional: force "supabase", "http" or "mock".
EXPO_PUBLIC_API_MODE=
