{
  "expo": {
    "name": "Hostel Laundry",
    "slug": "hostel-laundry",
    "version": "1.0.0",
    "scheme": "hostellaundry",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.thapar.hostellaundry",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used by laundry staff to scan student pickup QR codes."
      }
    },
    "android": {
      "package": "edu.thapar.hostellaundry",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2F5FD0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan student pickup QR codes."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}